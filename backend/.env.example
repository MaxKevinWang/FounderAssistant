DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_TIME_ZONE=Europe/Berlin

DB_ENGINE=django.db.backends.postgresql
DB_NAME=founder_assistant
DB_USER=founder
DB_PASSWORD=founder
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOW_ALL_ORIGINS=true

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Local Ollama:
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_TIMEOUT_SECONDS=360
LOCAL_LLM_API_KEY=
LOCAL_LLM_VERIFY_SSL=true
# Dedicated small model for structured request-risk assessment. The configured
# provider must expose this model; leave blank to reuse the answer model.
ADVISOR_GUARD_MODEL=ministral-3:14b
# Fail over to deterministic request assessment if the Guard model stalls.
ADVISOR_GUARD_TIMEOUT_SECONDS=30
# Optional model-specific Guard settings (for reasoning models, for example).
ADVISOR_GUARD_MAX_TOKENS=200
ADVISOR_GUARD_REASONING_EFFORT=

# OpenWebUI example:
# LOCAL_LLM_PROVIDER=openwebui
# LOCAL_LLM_BASE_URL=https://your-openwebui-server.example
# LOCAL_LLM_MODEL=qwen3.5:9b
# LOCAL_LLM_API_KEY=replace-with-your-open-webui-api-key
# LOCAL_LLM_VERIFY_SSL=true
# LOCAL_LLM_TIMEOUT_SECONDS=360
# LOCAL_RAG_EMBED_MODEL=qwen3-embedding:8b
LOCAL_RAG_EMBED_MODEL=bge-m3
# Leave blank for the existing dense-only path. Step-2 ablations explicitly use:
# LOCAL_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# LOCAL_RAG_RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
LOCAL_RAG_RERANKER_MODEL=
LOCAL_RAG_RERANKER_REVISION=
LOCAL_RAG_RERANKER_DEVICE=auto
LOCAL_RAG_RERANKER_BATCH_SIZE=4
LOCAL_RAG_RERANKER_MAX_LENGTH=512
LOCAL_RAG_DATA_DIR=../knowledge_base
LOCAL_RAG_INDEX_DIR=rag_index
LOCAL_RAG_CHUNK_SIZE=1200
LOCAL_RAG_CHUNK_OVERLAP=180
LOCAL_RAG_MIN_CHUNK_CHARS=180

# Closed-model evaluation Judge. Never commit the real API key.
OPENAI_API_KEY=
OPENAI_JUDGE_MODEL=gpt-5.4-mini
OPENAI_JUDGE_REASONING_EFFORT=low
OPENAI_JUDGE_MAX_OUTPUT_TOKENS=2500
OPENAI_JUDGE_TIMEOUT_SECONDS=120
OPENAI_JUDGE_MAX_RETRIES=2

# DeepSeek Responses API Judge. Never commit the real API key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_JUDGE_MODEL=deepseek-v4-flash
DEEPSEEK_JUDGE_REASONING_EFFORT=high
DEEPSEEK_JUDGE_MAX_OUTPUT_TOKENS=8000
DEEPSEEK_JUDGE_TIMEOUT_SECONDS=360
DEEPSEEK_JUDGE_MAX_RETRIES=3
